# Files NOT to include in the Docker build context.
# Smaller context = faster uploads to Cloud Build.

# Git
.git
.gitignore
.gitattributes

# Local env (secrets — server runtime gets these via --set-secrets, not in image)
.env
.env.local
.env.*.local

# Dependencies (re-installed inside builder stage)
node_modules
.pnp
.pnp.js

# Next.js build output (rebuilt inside the image)
.next
out
dist

# Testing
e2e
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
playwright.config.ts
playwright-report
test-results
vitest.config.ts
__tests__

# IDE / editor
.vscode
.idea
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*

# Docs / non-runtime
README.md
*.md
docs

# OS
Thumbs.db
ehthumbs.db

# Firebase config (we pivoted to Cloud Run direct)
.firebaserc
firebase.json
apphosting.yaml

# Vercel leftovers
.vercel
